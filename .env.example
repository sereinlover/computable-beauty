# Copy to .env.local (host dev, keep localhost URLs) or .env (docker compose,
# swap URLs to docker-network hostnames: http://engine:8000, postgres:5432,
# redis:6379). deploy-build.sh/deploy-pull.sh generate .env for you automatically.
# Never commit .env.local or .env — both are gitignored.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

POSTGRES_USER=cb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=computable_beauty
DATABASE_URL=postgresql://cb:changeme@localhost:5432/computable_beauty
REDIS_URL=redis://localhost:6379

# Change if any conflict with something on your machine.
GATEWAY_PORT=8080
ENGINE_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Update the port if you changed GATEWAY_PORT/ENGINE_PORT above.
GATEWAY_URL=http://localhost:8080
ENGINE_URL=http://localhost:8000

# Must match between gateway and engine.
INTERNAL_TOKEN=changeme

# Defaults to <repo-root>/data/uploads when unset.
# UPLOAD_DIR=
