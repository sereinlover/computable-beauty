# Copy to .env and fill in values. Never commit .env.

ANTHROPIC_API_KEY=

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://cb:changeme@localhost:5432/computable_beauty

REDIS_URL=redis://localhost:6379

# Service URLs (used by web and gateway in local dev without Docker)
GATEWAY_URL=http://localhost:8080
ENGINE_URL=http://localhost:8000

# Internal auth token — must match between gateway and engine
INTERNAL_TOKEN=changeme-internal
