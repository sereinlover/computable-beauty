# OS / editor
.DS_Store
.idea
.vscode

# ignore every .env.<suffix> variant except the committed template.
.env
.env.*
!.env.example

# Python — unscoped so it also covers contracts/'s own package, not just
# apps/engine/ (a leading-slash-less pattern matches at any depth).
__pycache__/
*.pyc

# apps/engine — Python
apps/engine/.venv/
apps/engine/venv/
apps/engine/*.egg-info/
apps/engine/.pytest_cache/
apps/engine/.mypy_cache/
apps/engine/.ruff_cache/

# apps/engine — scratch Jupyter notebooks for interactively exploring
# feature-extraction output; personal exploration, not part of the codebase.
apps/engine/notebooks/

# apps/engine — pretrained model weights, downloaded via `make models`.
apps/engine/classifiers/models/

# apps/gateway — Go
apps/gateway/bin/
apps/gateway/*.exe
apps/gateway/*.test

# Uploaded audio, training datasets — large, local-only.
/data/

# apps/web — Next.js / Node
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.turbo/
apps/web/npm-debug.log*
apps/web/yarn-error.log*

# logs / coverage
*.log
/logs/
coverage/
.coverage
htmlcov/

# Symlinks into ../computable-beauty-notes (separate private repo, not pushed here)
/CLAUDE.md
/doc
/articles
